{
  "name": "component-library-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Component library workspace with Figma integration",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "code-connect:publish": "npx figma connect publish",
    "code-connect:dry-run": "npx figma connect publish --dry-run"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
